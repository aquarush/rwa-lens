{
  "name": "rwa-lens",
  "version": "0.1.0",
  "private": true,
  "description": "Tokenised real-world-asset screener, monitor and AI paper-trading agent on the CoinMarketCap API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "mcp": "tsx mcp/server.ts",
    "record": "tsx scripts/record-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build:cf": "vite build && node scripts/build-cloudflare.mjs",
    "cf:dev": "wrangler pages dev dist-cf --d1 DB --port 8788",
    "cf:deploy": "wrangler pages deploy dist-cf"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "hono": "^4.13.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "chart.js": "^4.6.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
