# CoinMarketCap Pro API key (hackathon Startup tier via DoraHacks registration).
# Leave empty to run in MOCK mode on the synthetic fixtures in fixtures/.
CMC_API_KEY=
PORT=8787

# Anthropic API key for the AI trading agent. Leave empty to use the built-in
# rule-based strategy instead (the agent still runs, without the LLM).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
